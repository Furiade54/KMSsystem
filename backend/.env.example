# ============================================================================
#  KnowledgeManagementSystem — Backend
#  Archivo de ejemplo de variables de entorno
#  Copia este archivo como .env y ajusta los valores según tu entorno
# ============================================================================

# ----------------------------------------------------------------------------
#  Servidor
# ----------------------------------------------------------------------------

# Puerto en el que escucha el servidor backend
PORT=51478

# Entorno de ejecución: development | test | production
NODE_ENV=development

# ----------------------------------------------------------------------------
#  Autenticación JWT
# ----------------------------------------------------------------------------

# Clave secreta para firmar tokens JWT (mínimo 10 caracteres)
# En producción usa una cadena larga y aleatoria
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Tiempo de expiración de los tokens JWT (ej: 1h, 24h, 7d)
JWT_EXPIRES_IN=24h

# ----------------------------------------------------------------------------
#  Base de datos MSSQL
# ----------------------------------------------------------------------------

# Servidor MSSQL (nombre del host o IP)
SQL_SERVER=localhost

# Nombre de la instancia (dejar vacío para la instancia por defecto)
# Ejemplo para instancia nombrada: IST
SQL_INSTANCE_NAME=

# Puerto TCP de MSSQL (por defecto 1433)
SQL_PORT=1433

# Nombre de la base de datos
SQL_DATABASE=KMS

# Usuario de la base de datos
SQL_USER=sa

# Contraseña del usuario
SQL_PASSWORD=YourStrong!Password

# Usar conexión cifrada (true/false) — normalmente false en local
SQL_ENCRYPT=false

# ----------------------------------------------------------------------------
#  Almacenamiento de archivos
# ----------------------------------------------------------------------------

# Proveedor de almacenamiento: local | s3
STORAGE_PROVIDER=local

# Ruta relativa o absoluta para almacenamiento local
STORAGE_LOCAL_PATH=./storage

# ----------------------------------------------------------------------------
#  AWS S3 (solo si STORAGE_PROVIDER=s3)
# ----------------------------------------------------------------------------

# Región de AWS
# AWS_REGION=us-east-2

# Credenciales de acceso programático
# AWS_ACCESS_KEY_ID=AKIA_EXAMPLE
# AWS_SECRET_ACCESS_KEY=ExampleSecretKey

# Nombre del bucket S3
# AWS_S3_BUCKET=your-kms-bucket

# Tiempo de expiración de URLs prefirmadas (en segundos, por defecto 900 = 15min)
# AWS_S3_PRESIGNED_EXPIRES_IN=900

# ----------------------------------------------------------------------------
#  CORS
# ----------------------------------------------------------------------------

# Orígenes permitidos separados por coma (URL del frontend)
CORS_ORIGIN=http://localhost:51479
