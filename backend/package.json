{
  "name": "kms-backend",
  "version": "0.1.0",
  "description": "KMS API Server - Knowledge Management System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "set NODE_OPTIONS=--tls-min-v1.0 --tls-max-v1.2 && tsx watch src/server.ts",
    "dev:nix": "NODE_OPTIONS='--tls-min-v1.0 --tls-max-v1.2' tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "set NODE_OPTIONS=--tls-min-v1.0 --tls-max-v1.2 && node dist/server.js",
    "start:nix": "NODE_OPTIONS='--tls-min-v1.0 --tls-max-v1.2' node dist/server.js",
    "db:test": "set NODE_OPTIONS=--tls-min-v1.0 --tls-max-v1.2 && npx tsx -e \"import { testDbConnection } from './src/shared/db/pool'; (async()=>{const r=await testDbConnection(); console.log(r.ok ? ('OK: '+r.version) : ('FAIL: '+r.message)); process.exit(r.ok?0:1);})();\"",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mssql": "^10.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/mssql": "^9.1.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
