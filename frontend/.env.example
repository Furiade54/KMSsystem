# ============================================================================
#  KnowledgeManagementSystem — Frontend
#  Archivo de ejemplo de variables de entorno
#  Copia este archivo como .env y ajusta los valores según tu entorno
# ============================================================================

# URL base del backend (prefijo que consume la API.

# Si usas el proxy de Vite en modo desarrollo, puedes usar el prefijo '/api'
# Vite redirigirá /api → http://localhost:51478/api (configurado en vite.config.ts)
# Si despliegas frontend y backend por separado, indica la URL completa del backend
# Ejemplo: VITE_API_URL=http://localhost:51478/api
VITE_API_URL=/api

# Título mostrado en la pestaña del navegador y cabeceras de la aplicación
VITE_APP_TITLE=KMS
