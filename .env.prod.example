# ============================================================================
#  KMS — Producción (VPS Ubuntu) con MSSQL EXTERNO (IP pública)
#  Copia este archivo como .env.prod y completa los valores
# ============================================================================

# ----------------------------------------------------------------------------
#  MODO DE BASE DE DATOS
# ----------------------------------------------------------------------------
# external = MSSQL en otra máquina (IP pública, Azure SQL, VPS dedicada...)
# local    = MSSQL en Docker, en esta misma VPS (usa overlay docker-compose.local-db.yml)
DB_MODE=external

# ----------------------------------------------------------------------------
#  PUERTO DE ENTRADA (proxy Nginx)
# ----------------------------------------------------------------------------
APP_PORT=8080

# ----------------------------------------------------------------------------
#  BASE DE DATOS MSSQL EXTERNA
#  Rellénalas con los datos de tu SQL Server remoto
# ----------------------------------------------------------------------------
# IP / hostname público del SQL Server.
SQL_SERVER=203.0.113.45

# Nombre de instancia (si SQL Server usa instancia nombrada, ej: SQLEXPRESS)
# Déjalo VACÍO si el servidor usa la instancia por defecto (puerto TCP directo)
SQL_INSTANCE_NAME=

# Puerto TCP del SQL Server (normalmente 1433)
SQL_PORT=1433

# Nombre de la base de datos. Si no existe, db-init la creará.
SQL_DATABASE=KMS

# Usuario SQL (ej: sa, o un usuario dedicado con role dbcreator + db_owner)
SQL_USER=sa

# Contraseña del usuario SQL
SQL_PASSWORD=TuContraseña_SQLServer_Aqui_123!

# Usar cifrado en la conexión (encrypt=true/false)
# Azure SQL / SQL Server moderno con cert válido: true
# SQL Server on-prem / auto-firmado:    false (el driver usa -C / trust-server-cert)
SQL_ENCRYPT=false

# ----------------------------------------------------------------------------
#  AUTENTICACIÓN JWT
# ----------------------------------------------------------------------------
# Genera una cadena larga aleatoria. Ejecuta en tu máquina:
#   openssl rand -base64 64
JWT_SECRET=genera-una-cadena-larga-aleatoria-aqui-con-minimo-10-caracteres

# Tiempo de expiración de los tokens (ej: 1h, 12h, 24h, 7d)
JWT_EXPIRES_IN=24h

# ----------------------------------------------------------------------------
#  ALMACENAMIENTO DE ARCHIVOS
# ----------------------------------------------------------------------------
# local = volumen Docker de la VPS (recomendado para empezar)
# s3    = bucket AWS S3 compatible
STORAGE_PROVIDER=local

# Variables AWS (solo si STORAGE_PROVIDER=s3)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PRESIGNED_EXPIRES_IN=900

# ----------------------------------------------------------------------------
#  FRONTEND (Build time)
# ----------------------------------------------------------------------------
# Si el dominio es https://kms.miempresa.com y el proxy está en /api, dejar /api
VITE_API_URL=/api
VITE_APP_TITLE=KMS

# ----------------------------------------------------------------------------
#  CORS (normalmente no tocar)
# ----------------------------------------------------------------------------
# En producción todo pasa por el proxy, así que * es seguro ya que el puerto
# del backend NO está expuesto a internet.
CORS_ORIGIN=*
